{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3500",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3500",
    "lint": "next lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mariadb",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "db:import:excel": "node --env-file=.env scripts/import-excel.mjs",
    "uploads:migrate:paths": "node prisma/migrate-upload-paths.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tremor/react": "^3.18.7",
    "bcryptjs": "^3.0.3",
    "next": "14.2.28",
    "prisma": "^6.18.0",
    "react": "^18",
    "react-dom": "^18",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.28",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.mjs"
  }
}
